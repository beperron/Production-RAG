# Server-side env for the Next.js API routes (set these in Vercel Project Settings).
# The deployed app uses ONLY the read-only publishable key — never the service_role key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
JINA_API_KEY=
# Grounded answers now use Ollama Cloud (deepseek-v4-flash:cloud):
OLLAMA_KEY=
# Optional override
OLLAMA_GEN_MODEL=deepseek-v4-flash:cloud
